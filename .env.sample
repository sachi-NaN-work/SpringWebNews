# 環境
SPRING_PROFILES_ACTIVE=dev
# 本番環境
# SPRING_PROFILES_ACTIVE=prod

# サーバーポート（基本ポートは 8080 ）
SERVER_PORT=8080

# R2DBC (基本ホストは postgres 、基本ポートは 5432 ）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=******************
POSTGRES_USER=******************
POSTGRES_PASSWORD=******************

# Redis（基本ポートは 6379 ）
REDIS_PORT=6379
REDIS_PASSWORD=******************

# Kafka（基本ホストは kafka:9093 ）
KAFKA_BOOTSTRAP_SERVERS=kafka:9093

# Springdoc
SPRINGDOC_ENABLED=true
